# Obligatoire en production : chaîne aléatoire longue et privée
SECRET_KEY=remplacez-par-une-cle-aleatoire-longue
# Code admin par défaut demandé. Remplacez-le en production par un code fort.
ADMIN_PASSWORD=3004
ADMIN_EMAIL=admin@proxiservice.com
# Chemin de base de données : utiliser un disque persistant Render si SQLite.
DATABASE_PATH=/var/data/proxiservice.db
# Mettre true si le site est servi en HTTPS (Render)
COOKIE_SECURE=true
PORT=5000
